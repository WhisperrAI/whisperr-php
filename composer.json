{
  "name": "whisperr/php",
  "description": "Whisperr server-side SDK for PHP (with Laravel support) \u2014 reliable churn-signal event tracking.",
  "type": "library",
  "keywords": [
    "whisperr",
    "analytics",
    "churn",
    "events",
    "tracking",
    "retention",
    "laravel"
  ],
  "homepage": "https://whisperr.net",
  "license": "MIT",
  "authors": [
    {
      "name": "Whisperr"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5",
    "illuminate/support": "^8.83 || ^9.0 || ^10.0 || ^11.0",
    "illuminate/container": "^8.83 || ^9.0 || ^10.0 || ^11.0",
    "illuminate/config": "^8.83 || ^9.0 || ^10.0 || ^11.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "suggest": {
    "illuminate/support": "Required only when using the Laravel service provider and facade."
  },
  "autoload": {
    "psr-4": {
      "Whisperr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Whisperr\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Whisperr\\Laravel\\WhisperrServiceProvider"
      ],
      "aliases": {
        "Whisperr": "Whisperr\\Laravel\\Facades\\Whisperr"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
